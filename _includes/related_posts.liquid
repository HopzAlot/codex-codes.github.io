{% if site.related_blog_posts.enabled %}
  {% assign related = site.posts | where_exp: "post", "post.url != page.url" %}

  {% comment %} Filter by shared tags {% endcomment %}
  {% assign related_by_tag = "" | split: "" %}
  {% for post in related %}
    {% assign shared = post.tags | where_exp: "tag", "page.tags contains tag" %}
    {% if shared.size > 0 %}
      {% assign related_by_tag = related_by_tag | push: post %}
    {% endif %}
  {% endfor %}

  {% comment %} Fall back to any recent posts if no tag overlap {% endcomment %}
  {% if related_by_tag.size > 0 %}
    {% assign related_posts = related_by_tag | slice: 0, site.related_blog_posts.max_related %}
  {% else %}
    {% assign related_posts = related | slice: 0, site.related_blog_posts.max_related %}
  {% endif %}

  {% if related_posts.size > 0 %}
    <div class="related-posts mt-5">
      <h2>Related Posts</h2>
      <ul class="post-list">
        {% for post in related_posts %}
          <li>
            {% assign year = post.date | date: "%Y" %}
            <h3>
              <a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
            </h3>
            {% if post.description %}
              <p>{{ post.description }}</p>
            {% endif %}
            <p class="post-meta">
              <a href="{{ year | prepend: '/blog/' | relative_url }}">
                <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
              </a>
              {% assign tags = post.tags | join: "" %}
              {% if tags != "" %}
                &nbsp; &middot; &nbsp;
                {% for tag in post.tags %}
                  <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">
                    <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
                  {% unless forloop.last %}&nbsp;{% endunless %}
                {% endfor %}
              {% endif %}
            </p>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
{% endif %}
